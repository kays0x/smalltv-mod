      "x": 20,
      "y": 100,
      "value": "{claude.project}",
      "size": 16,
      "color": "#ffffff",
      "anchor": "top-left",
      "scroll": {
        "width": 200,
        "mode": "bounce",
        "speed": 20,
        "pause": 1000
