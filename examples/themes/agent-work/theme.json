{
  "spec": 1,
  "theme": {
    "id": "agent-work",
    "name": "Agent Work",
    "author": "SmallTV fork",
    "version": "1.1.0"
  },
  "display": {
    "width": 240,
    "height": 240,
    "background": "#000000"
  },
  "data": [
    {
      "id": "claude",
      "url": "http://192.0.2.10:9879/agent-top.json",
      "interval": 10,
      "fields": [
        {
          "id": "status",
          "path": "status"
        },
        {
          "id": "count",
          "path": "count"
        },
        {
          "id": "elapsed",
          "path": "elapsed"
        },
        {
          "id": "project",
          "path": "project"
        },
        {
          "id": "detail",
          "path": "detail"
        },
        {
          "id": "title",
          "path": "title"
        },
        {
          "id": "tone",
          "path": "tone"
        },
        {
          "id": "stamp",
          "path": "stamp"
        }
      ]
    },
    {
      "id": "codex",
      "url": "http://192.0.2.10:9879/agent-bottom.json",
      "interval": 10,
      "fields": [
        {
          "id": "status",
          "path": "status"
        },
        {
          "id": "count",
          "path": "count"
        },
        {
          "id": "elapsed",
          "path": "elapsed"
        },
        {
          "id": "project",
          "path": "project"
        },
        {
          "id": "detail",
          "path": "detail"
        },
        {
          "id": "title",
          "path": "title"
        },
        {
          "id": "tone",
          "path": "tone"
        },
        {
          "id": "stamp",
          "path": "stamp"
        }
      ]
    }
  ],
  "layers": [
    {
      "id": "heading",
      "type": "text",
      "x": 8,
      "y": 8,
      "value": "AGENTS",
      "size": 24,
      "color": "#ffffff",
      "anchor": "top-left"
    },
    {
      "id": "stamp",
      "type": "text",
      "x": 228,
      "y": 16,
      "value": "{codex.stamp}",
      "size": 12,
      "color": "#b0aea5",
      "anchor": "top-right"
    },
    {
      "id": "claude-panel",
      "type": "shape",
      "shape": "rectangle",
      "x": 8,
      "y": 38,
      "width": 224,
      "height": 96,
      "cornerRadius": 8,
      "fill": "#1f1f1e"
    },
    {
      "id": "claude-title",
      "type": "text",
      "x": 20,
      "y": 46,
      "value": "{claude.title}",
      "size": 16,
      "color": "#d97757",
      "anchor": "top-left"
    },
    {
      "id": "claude-count",
      "type": "text",
      "x": 220,
      "y": 46,
      "value": "{claude.count}",
      "size": 16,
      "color": "#b0aea5",
      "anchor": "top-right"
    },
    {
      "id": "claude-status",
      "type": "text",
      "x": 20,
      "y": 70,
      "value": "{claude.status}",
      "size": 24,
      "color": "#ffffff",
      "anchor": "top-left",
      "bind": {
        "color": {
          "source": "claude.tone",
          "stops": [
            {
              "at": 0,
              "value": "#b0aea5"
            },
            {
              "at": 1,
              "value": "#86e2bf"
            },
            {
              "at": 2,
              "value": "#f0b429"
            }
          ]
        }
      }
    },
    {
      "id": "claude-elapsed",
      "type": "text",
      "x": 220,
      "y": 74,
      "value": "{claude.elapsed}",
      "size": 16,
      "color": "#b0aea5",
      "anchor": "top-right"
    },
    {
