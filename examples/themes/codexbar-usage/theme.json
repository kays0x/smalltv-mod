{
  "spec": 1,
  "theme": {
    "id": "codexbar-usage",
    "name": "CodexBar Usage",
    "author": "SmallTV fork",
    "version": "1.3.0"
  },
  "display": {
    "width": 240,
    "height": 240,
    "background": "#000000"
  },
  "data": [
    {
      "id": "codex",
      "url": "http://192.0.2.10:9879/codex.json",
      "interval": 15,
      "fields": [
        {
          "id": "sessionText",
          "path": "sessionText"
        },
        {
          "id": "sessionBar",
          "path": "sessionBar"
        },
        {
          "id": "sessionReset",
          "path": "sessionReset"
        },
        {
          "id": "weeklyText",
          "path": "weeklyText"
        },
        {
          "id": "weeklyBar",
          "path": "weeklyBar"
        },
        {
          "id": "weeklyReset",
          "path": "weeklyReset"
        },
        {
          "id": "state",
          "path": "state"
        }
      ]
    },
    {
      "id": "claude",
      "url": "http://192.0.2.10:9879/claude.json",
      "interval": 15,
      "fields": [
        {
          "id": "sessionText",
          "path": "sessionText"
        },
        {
          "id": "sessionBar",
          "path": "sessionBar"
        },
        {
          "id": "sessionReset",
          "path": "sessionReset"
        },
        {
          "id": "weeklyText",
          "path": "weeklyText"
        },
        {
          "id": "weeklyBar",
          "path": "weeklyBar"
        },
        {
          "id": "weeklyReset",
          "path": "weeklyReset"
        },
        {
          "id": "state",
          "path": "state"
        }
      ]
    }
  ],
  "layers": [
    {
      "id": "claude-title",
      "type": "text",
      "x": 8,
      "y": 8,
      "value": "CLAUDE",
      "size": 24,
      "color": "#d97757",
      "anchor": "top-left"
    },
    {
      "id": "claude-state",
      "type": "text",
      "x": 228,
      "y": 14,
      "value": "{claude.state}",
      "size": 12,
      "color": "#b0aea5",
      "anchor": "top-right"
    },
    {
      "id": "claude-session-panel",
      "type": "shape",
      "shape": "rectangle",
      "x": 8,
      "y": 36,
      "width": 224,
      "height": 54,
      "cornerRadius": 8,
      "fill": "#1f1f1e"
    },
    {
      "id": "claude-session-percent",
      "type": "text",
      "x": 20,
      "y": 40,
      "value": "{claude.sessionText}",
      "size": 32,
      "color": "#ffffff",
      "anchor": "top-left"
    },
    {
      "id": "claude-session-label",
      "type": "text",
      "x": 220,
      "y": 40,
      "value": "5h",
      "size": 16,
      "color": "#b0aea5",
      "anchor": "top-right"
    },
    {
      "id": "claude-session-reset",
      "type": "text",
      "x": 220,
      "y": 60,
      "value": "{claude.sessionReset}",
      "size": 16,
      "color": "#b0aea5",
      "anchor": "top-right"
    },
    {
      "id": "claude-session-track",
      "type": "shape",
      "shape": "rectangle",
      "x": 20,
      "y": 78,
      "width": 200,
      "height": 10,
      "cornerRadius": 5,
      "fill": "#2a2a28"
    },
    {
      "id": "claude-session-bar",
      "type": "shape",
      "shape": "rectangle",
      "x": 20,
      "y": 78,
      "width": 1,
      "height": 10,
      "cornerRadius": 5,
      "fill": "#788c5d",
      "bind": {
        "width": {
          "source": "claude.sessionBar",
          "input": [
            0,
            100
          ],
          "output": [
            0,
            200
          ]
        },
        "fill": {
          "source": "claude.sessionBar",
          "stops": [
            {
              "at": 0,
              "value": "#788c5d"
            },
            {
              "at": 75,
              "value": "#d97757"
            },
            {
              "at": 90,
              "value": "#e5484d"
            }
          ]
        }
      }
    },
    {
      "id": "claude-weekly-panel",
      "type": "shape",
      "shape": "rectangle",
      "x": 8,
      "y": 94,
      "width": 224,
      "height": 54,
      "cornerRadius": 8,
      "fill": "#1f1f1e"
    },
    {
      "id": "claude-weekly-percent",
      "type": "text",
      "x": 20,
      "y": 98,
      "value": "{claude.weeklyText}",
      "size": 32,
      "color": "#ffffff",
      "anchor": "top-left"
    },
    {
      "id": "claude-weekly-label",
      "type": "text",
      "x": 220,
      "y": 98,
      "value": "7d",
      "size": 16,
      "color": "#b0aea5",
      "anchor": "top-right"
    },
    {
      "id": "claude-weekly-reset",
      "type": "text",
      "x": 220,
      "y": 118,
      "value": "{claude.weeklyReset}",
      "size": 16,
      "color": "#b0aea5",
      "anchor": "top-right"
    },
    {
      "id": "claude-weekly-track",
      "type": "shape",
      "shape": "rectangle",
      "x": 20,
      "y": 136,
      "width": 200,
      "height": 10,
      "cornerRadius": 5,
      "fill": "#2a2a28"
    },
    {
      "id": "claude-weekly-bar",
      "type": "shape",
      "shape": "rectangle",
      "x": 20,
      "y": 136,
      "width": 1,
      "height": 10,
      "cornerRadius": 5,
      "fill": "#788c5d",
      "bind": {
        "width": {
          "source": "claude.weeklyBar",
          "input": [
            0,
            100
          ],
          "output": [
            0,
            200
          ]
        },
        "fill": {
          "source": "claude.weeklyBar",
          "stops": [
            {
              "at": 0,
              "value": "#788c5d"
            },
            {
              "at": 75,
              "value": "#d97757"
            },
            {
              "at": 90,
              "value": "#e5484d"
            }
          ]
        }
      }
    },
    {
      "id": "codex-title",
      "type": "text",
      "x": 8,
      "y": 154,
      "value": "CODEX",
      "size": 24,
      "color": "#7dc5ff",
      "anchor": "top-left"
    },
    {
      "id": "codex-state",
      "type": "text",
      "x": 228,
      "y": 160,
      "value": "{codex.state}",
      "size": 12,
      "color": "#b0aea5",
      "anchor": "top-right"
    },
    {
      "id": "codex-weekly-panel",
      "type": "shape",
      "shape": "rectangle",
      "x": 8,
      "y": 184,
      "width": 224,
      "height": 54,
      "cornerRadius": 8,
      "fill": "#1f1f1e"
    },
    {
      "id": "codex-weekly-percent",
      "type": "text",
      "x": 20,
      "y": 188,
      "value": "{codex.weeklyText}",
      "size": 32,
      "color": "#ffffff",
      "anchor": "top-left"
    },
    {
      "id": "codex-weekly-label",
      "type": "text",
      "x": 220,
      "y": 188,
      "value": "7d",
      "size": 16,
      "color": "#b0aea5",
      "anchor": "top-right"
    },
    {
      "id": "codex-weekly-reset",
      "type": "text",
      "x": 220,
      "y": 208,
      "value": "{codex.weeklyReset}",
      "size": 16,
      "color": "#b0aea5",
      "anchor": "top-right"
    },
    {
      "id": "codex-weekly-track",
      "type": "shape",
      "shape": "rectangle",
      "x": 20,
      "y": 226,
      "width": 200,
      "height": 10,
      "cornerRadius": 5,
      "fill": "#2a2a28"
    },
    {
      "id": "codex-weekly-bar",
      "type": "shape",
      "shape": "rectangle",
      "x": 20,
      "y": 226,
      "width": 1,
      "height": 10,
      "cornerRadius": 5,
      "fill": "#788c5d",
      "bind": {
        "width": {
          "source": "codex.weeklyBar",
          "input": [
            0,
            100
          ],
          "output": [
            0,
            200
          ]
        },
        "fill": {
          "source": "codex.weeklyBar",
          "stops": [
            {
              "at": 0,
              "value": "#788c5d"
            },
            {
              "at": 75,
              "value": "#d97757"
            },
            {
              "at": 90,
              "value": "#e5484d"
            }
          ]
        }
      }
    }
  ]
}
